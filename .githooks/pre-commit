#!/usr/bin/env bash
# Block commits that add secrets. Needs gitleaks (brew bundle installs it).
if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks not installed; run 'brew bundle' (skipping scan)" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
